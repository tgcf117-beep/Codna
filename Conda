wget https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda/Miniconda3-latest-Linux-x86_64.sh   #清华源下载Miniconda
bush Miniconda3-latest-Linux-86_64.sh   #执行安装脚本，直到出现yes/no,输入yes,后续问题也是yes
source ~/.bashrc
conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main/
conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/r/
conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/msys2/
conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/bioconda/
conda config --set show_channel_urls yes   #更换Conda清华源（解决后面bioconda下载慢）
conda create -n edta_env python=3.8 -y   #新建EDTA专属环境
conda activate edta_env   #激活环境x
