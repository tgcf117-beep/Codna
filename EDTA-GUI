git clone https://github.com/Marcos-Fernando/EDTA-GUI.git /root/EDTA-GUI

echo '===== 检查下载结果 ====='
if [ -d /root/EDTA-GUI/.git ]; then
    git -C /root/EDTA-GUI rev-parse HEAD
    ls -lh /root/EDTA-GUI
    echo '===== 官方安装说明 ====='
    sed -n '1,240p' /root/EDTA-GUI/README.md
