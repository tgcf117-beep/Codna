echo '===== EDTA-GUI安装说明前120行 ====='
head -n 120 /root/EDTA-GUI/README.md

cd /root/EDTA-GUI &&
git switch --detach v1.1 &&
echo '===== 已选版本 =====' &&
git describe --tags --exact-match &&
